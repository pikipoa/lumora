# Supabaseプロジェクトの接続情報（ダッシュボード → Project Settings → API Keys）
# このファイルを .env にコピーして実際の値を入れる（.env はgit管理外）
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Sentry（エラー監視。未設定でもアプリは動く＝Sentryへの送信のみ無効化される）
# DSN取得：Sentryダッシュボード → Project Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=
# development / preview / production（Vercelのenvironmentに合わせる。未設定時はdevelopment扱い）
EXPO_PUBLIC_APP_ENV=development
